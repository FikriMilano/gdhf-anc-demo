  "extension": [
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "lmp",
        "language": "text/fhirpath",
        "expression": "%resource.repeat(item).where(linkId='lmp').answer.value"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "today",
        "language": "text/fhirpath",
        "expression": "today()"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "todayDayNumber",
        "language": "text/fhirpath",
        "description": "Julian Day Number of %today. kotlin-fhirpath 1.0.0-beta06 has no duration()/difference() and cannot subtract dates, so GA uses day numbers. Integer division is written (a / b).truncate() because 'div' and 'mod' throw for some operands in beta06.",
        "expression": "%today.select(dayOf() + ((153 * (monthOf() + 12 * ((14 - monthOf()) / 12).truncate() - 3) + 2) / 5).truncate() + 365 * (yearOf() + 4800 - ((14 - monthOf()) / 12).truncate()) + ((yearOf() + 4800 - ((14 - monthOf()) / 12).truncate()) / 4).truncate() - ((yearOf() + 4800 - ((14 - monthOf()) / 12).truncate()) / 100).truncate() + ((yearOf() + 4800 - ((14 - monthOf()) / 12).truncate()) / 400).truncate())"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "lmpDayNumber",
        "language": "text/fhirpath",
        "description": "Day number (Julian Day Number) of %lmp; same formula as todayDayNumber.",
        "expression": "%lmp.select(dayOf() + ((153 * (monthOf() + 12 * ((14 - monthOf()) / 12).truncate() - 3) + 2) / 5).truncate() + 365 * (yearOf() + 4800 - ((14 - monthOf()) / 12).truncate()) + ((yearOf() + 4800 - ((14 - monthOf()) / 12).truncate()) / 4).truncate() - ((yearOf() + 4800 - ((14 - monthOf()) / 12).truncate()) / 100).truncate() + ((yearOf() + 4800 - ((14 - monthOf()) / 12).truncate()) / 400).truncate())"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "gaDays",
        "language": "text/fhirpath",
        "expression": "%todayDayNumber - %lmpDayNumber"
      }
    },
