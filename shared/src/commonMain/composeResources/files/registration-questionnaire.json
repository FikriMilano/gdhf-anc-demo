  "item": [
    {
      "linkId": "given-name",
      "text": "Given name",
      "type": "string",
      "required": true
    },
    {
      "linkId": "family-name",
      "text": "Family name",
      "type": "string",
      "required": true
    },
    {
      "linkId": "birth-date",
      "text": "Date of birth",
      "type": "date",
      "required": true,
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-constraint",
          "extension": [
            {
              "url": "key",
              "valueId": "birth-date-past"
            },
            {
              "url": "severity",
              "valueCode": "error"
            },
            {
              "url": "expression",
              "valueString": "%resource.repeat(item).where(linkId='birth-date').answer.value.all($this < today())"
            },
            {
              "url": "human",
              "valueString": "Date of birth must be in the past"
            }
          ]
        }
      ]
    },
    {
      "linkId": "lmp",
      "text": "First day of last menstrual period",
      "type": "date",
      "required": true,
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-constraint",
          "extension": [
            {
              "url": "key",
              "valueId": "lmp-range"
            },
            {
              "url": "severity",
              "valueCode": "error"
            },
            {
              "url": "expression",
              "valueString": "%resource.repeat(item).where(linkId='lmp').answer.value.all($this <= today() and $this >= today() - 300 days)"
            },
            {
              "url": "human",
              "valueString": "LMP must be within the last 300 days"
            }
          ]
        }
      ]
    },
    {
      "linkId": "gestational-age",
      "text": "Gestational age",
      "type": "string",
      "readOnly": true,
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
          "valueExpression": {
            "language": "text/fhirpath",
            "expression": "%gaDays.select(($this / 7).truncate().toString() + ' w ' + ($this - 7 * ($this / 7).truncate()).toString() + ' d')"
          }
        }
      ]
    },
    {
      "linkId": "ga-days",
      "text": "Gestational age (days)",
      "type": "integer",
      "readOnly": true,
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-hidden",
          "valueBoolean": true
        },
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
          "valueExpression": {
            "language": "text/fhirpath",
            "expression": "%gaDays"
          }
        }
      ]
    },
    {
      "linkId": "edd",
      "text": "Estimated due date",
      "type": "date",
      "readOnly": true,
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
          "valueExpression": {
            "language": "text/fhirpath",
            "expression": "%lmp + 280 days"
          }
        }
      ]
    },
    {
      "linkId": "previous-pregnancies",
      "text": "Previous pregnancies?",
      "type": "boolean"
    },
    {
      "linkId": "pregnancy-count",
      "text": "Number of previous pregnancies",
      "type": "integer",
      "enableWhen": [
        {
          "question": "previous-pregnancies",
          "operator": "=",
          "answerBoolean": true
        }
      ],
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-constraint",
          "extension": [
            {
              "url": "key",
              "valueId": "pregnancy-count-range"
            },
            {
              "url": "severity",
              "valueCode": "error"
            },
            {
              "url": "expression",
              "valueString": "%resource.repeat(item).where(linkId='pregnancy-count').answer.value.all($this >= 1 and $this <= 20)"
            },
            {
              "url": "human",
              "valueString": "Enter a number from 1 to 20"
            }
          ]
        }
      ]
    },
    {
      "linkId": "live-births",
      "text": "Number of live births",
      "type": "integer",
      "enableWhen": [
        {
          "question": "previous-pregnancies",
          "operator": "=",
          "answerBoolean": true
        }
      ],
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-constraint",
          "extension": [
            {
              "url": "key",
              "valueId": "live-births-range"
            },
            {
              "url": "severity",
              "valueCode": "error"
            },
            {
              "url": "expression",
              "valueString": "%resource.repeat(item).where(linkId='live-births').answer.value.all($this >= 0 and $this <= 20)"
            },
            {
              "url": "human",
              "valueString": "Enter a number from 0 to 20"
            }
          ]
        }
      ]
    },
    {
      "linkId": "bp-systolic",
      "text": "Systolic blood pressure (mmHg)",
      "type": "integer",
      "required": true,
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-constraint",
          "extension": [
            {
              "url": "key",
              "valueId": "bp-systolic-range"
            },
            {
              "url": "severity",
              "valueCode": "error"
            },
            {
              "url": "expression",
              "valueString": "%resource.repeat(item).where(linkId='bp-systolic').answer.value.all($this >= 50 and $this <= 300)"
            },
            {
              "url": "human",
              "valueString": "Systolic must be between 50 and 300 mmHg"
            }
          ]
        }
      ]
    },
    {
      "linkId": "bp-diastolic",
      "text": "Diastolic blood pressure (mmHg)",
      "type": "integer",
      "required": true,
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-constraint",
          "extension": [
            {
              "url": "key",
              "valueId": "bp-diastolic-range"
            },
            {
              "url": "severity",
              "valueCode": "error"
            },
            {
              "url": "expression",
              "valueString": "%resource.repeat(item).where(linkId='bp-diastolic').answer.value.all($this >= 30 and $this <= 200)"
            },
            {
              "url": "human",
              "valueString": "Diastolic must be between 30 and 200 mmHg"
            }
          ]
        },
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-constraint",
          "extension": [
            {
              "url": "key",
              "valueId": "bp-diastolic-below-systolic"
            },
            {
              "url": "severity",
              "valueCode": "error"
            },
            {
              "url": "expression",
              "valueString": "%resource.repeat(item).where(linkId='bp-systolic').answer.value.empty() or %resource.repeat(item).where(linkId='bp-diastolic').answer.value.all($this < %resource.repeat(item).where(linkId='bp-systolic').answer.value.first())"
            },
            {
              "url": "human",
              "valueString": "Diastolic must be lower than systolic"
            }
          ]
        }
      ]
    }
  ]
